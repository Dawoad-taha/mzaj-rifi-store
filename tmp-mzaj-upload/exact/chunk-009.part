            return window.sessionStorage.getItem(LOADER_KEY) === '1';
        } catch (error) {
            return false;
        }
    }

    function markAsShown() {
        try {
            window.sessionStorage.setItem(LOADER_KEY, '1');
        } catch (error) {
            /* إذا كان التخزين محظوراً، نكمل بدون تعطيل الصفحة */
